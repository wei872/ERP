# ============================================================
# ERP 商用部署环境变量模板
# 用法：cp .env.example .env 并填写下列必填项（.env 已被 git 忽略）
# ============================================================

# 【必填】MySQL root 密码（首次初始化数据卷时生效）
MYSQL_PASSWORD=CHANGE_ME_strong_db_password

# 【必填】JWT 签名密钥：至少 32 字符的强随机串。
# 生成示例：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_random_32plus_chars

# 【强烈建议】首个 admin 账号的初始密码（仅首次创建时生效，重启不会覆盖）。
# 不填则默认 admin123 —— 生产环境务必修改。登录后也可在用户管理中再调整。
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_initial_password

# 【可选】是否播种 zhangsan/lisi 等演示账号。生产环境保持 false（默认）。
SEED_DEMO_USERS=false

# 【可选】前端对外端口（默认 8081）
PORT=8081

# 【可选】前后端分离部署时的跨域白名单（逗号分隔），同源反代部署留空即可
CORS_ALLOWED_ORIGINS=

# 【可选】Token 有效期（毫秒），默认 24 小时
JWT_EXPIRATION=86400000

# 【可选】后端日志级别
LOG_LEVEL=info
